# All optional. The app works with zero keys — ATS + free APIs need none.
# Copy this file to .env and fill in only the ones you want.

# Adzuna — covers India, free tier 250 calls/day. https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — aggregates Google Jobs / LinkedIn / Indeed. Best India coverage.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Jooble — India supported. https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Supabase (public submissions + the All-jobs view) ---
# Create a free project, run supabase/schema.sql, then copy these from Settings > API.
# SUPABASE_SERVICE_KEY bypasses row-level security, so it goes HERE and in GitHub
# Actions secrets only - never in site/config.js, which the browser can read.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
